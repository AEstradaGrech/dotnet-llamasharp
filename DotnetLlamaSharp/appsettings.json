{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "@mt = 'An unhandled exception has occurred while executing the request.'"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ChromaSettings": {
    "ServerUrl": "http://localhost:8000",
    "EmbeddingsModel": "nomic-embed-text",
    "EmbeddingDimensions": 512
  },
  "LangSearchSettings": {
    "Domain": "https://api.langsearch.com",
    "WebSearchEndpoint": "v1/web-search",
    "RankedSearchEndpoint": "v1/rerank",
    "DefaultRerankModel": "langsearch-reranker-v1",
    "ApiKey": "<your-api-key-here>"
  },
  "ApiSettings": {
    "DefaultUserName": "OllamaDeveloper",
    "DefaultModel": "hermes3",
    "DefaultEmbedder": "nomic-embed-text",
    "JsonOutputTopP": 0.1,
    "JsonOutputTopK": 10,
    "JsonOutputTemp": 0.0,
    "RagChatChunkSize": 1200,
    "RagChatMemoryRetrievals": 4,
    "RagChatMemoMinDistance": 0,
    "JsonModels": [ "hermes3", "qwen2.5:7b", "qwen2.5:14b", "gemma3:27b" ]
  },
  "OllamaSettings": {
    "OllamaUrl": "http://localhost:11434",
    "DefaultModel": "qwen2.5:7b",
    "Models": [ "hermes3", "qwen2.5:7b", "qwen2.5:14b", "gemma3:27b" ],
    "EmbeddingModels": [ "nomic-embed-text", "qwen3-embedding:0.6b", "mxbai-embed-large:latest", "all-minilm" ],
    "MiroStat": 1,
    "MiroStatEta": null,
    "MiroStatTau": null,
    "NumCtx": 4060,
    "NumGqa": null,
    "NumGpu": -1,
    "MainGpu": null,
    "NumThread": 6,
    "NumKeep": null,
    "RepeatLastN": null,
    "RepeatPenalty": null,
    "PresencePenalty": null,
    "FrequencyPenalty": null,
    "Temperature": 0.7,
    "Seed": null,
    "Stop": null,
    "Tfs_z": null,
    "NumPredict": 600,
    "TopK": null,
    "TopP": null,
    "MinP": null,
    "TypicalP": null,
    "PenalizeNewline": null,
    "UseMmap": null,
    "UseMlock": null,
    "LowVram": null,
    "F16kv": null,
    "LogitsAll": null,
    "VocabOnly": null,
    "Numa": null
  }
}
