{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "@mt = 'An unhandled exception has occurred while executing the request.'"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "DocumentLoader": {
    "ResourcesPath": "<path-to-repo>\\DotnetLlamaSharp.Infrastructure\\Data\\Resources"
  },
  "ChromaSettings": {
    "ServerUrl": "http://localhost:7070",
    "EmbeddingsModel": "nomic-embed-text",
    "EmbeddingDimensions": 512,
    "Tenant": "default_tenant",
    "Database": "default_database",
    "HnswSettings": {
      "Space": "cosine",
      "EfConstruction": 200,
      "MaxNeighbors": 32,
      "EfSearch": 100,
      "NumThreads": 4
    }
  },
  "LangSearchSettings": {
    "Domain": "https://api.langsearch.com",
    "WebSearchEndpoint": "v1/web-search",
    "ApiKey": "<your-api-key-here>"
  },
  "GroqSettings": {
    "BaseUrl": "https://api.groq.com",
    "ApiKey": "<your-api-key-here>",
    "DefaultModel": "llama-3.3-70b-versatile",
    "ToolModels": [ "llama-3.3-70b-versatile", "qwen/qwen3-32b", "qwen/qwen3.6-27b" ],
    "JsonModels": [ "openai/gpt-oss-20b", "openai/gpt-oss-120b" ],
    "ReasoningModels": [ "openai/gpt-oss-120b", "openai/gpt-oss-20b", "qwen/qwen3-32b", "qwen/qwen3.6-27b" ],
    "Endpoints": {
      "chat": "/openai/v1/chat/completions"
    }
  },
  "ClaudeSettings": {
    "apiKey": "<your-api-key-here>",
    "defaultModel": "claude-sonnet-4-6"
  },
  "ApiSettings": {
    "DefaultUserName": "UnknownDeveloper",
    "DefaultModel": "hermes3",
    "DefaultEmbedder": "nomic-embed-text",
    "JsonOutputTopP": 0.1,
    "JsonOutputTopK": 10,
    "JsonOutputTemp": 0.0,
    "RagChatChunkSize": 1200,
    "RagChatMemoryRetrievals": 4,
    "RagChatMemoMinDistance": 0,
    "EmbeddingModels": [ "nomic-embed-text", "qwen3-embedding:0.6b", "mxbai-embed-large:latest", "all-minilm" ],
    "JsonModels": ["qwen2.5:7b", "hermes3" ],
    "Endpoints": {
      "ollama": "http://localhost:11434",
      "chroma": "http://localhost:7070",
      "langsearch-web": "https://api.langsearch.com/v1/web-search"
    }
  },
  "OllamaSettings": {
    "OllamaUrl": "http://localhost:11434",
    "TimeoutMinutes": 10,
    "DefaultModel": "qwen2.5:7b",
    "Models": [ "qwen2.5:7b", "hermes3" ],
    "EmbeddingModels": [ "nomic-embed-text", "qwen3-embedding:0.6b", "mxbai-embed-large:latest", "all-minilm" ],
    "MiroStat": 1,
    "MiroStatEta": null,
    "MiroStatTau": null,
    "NumCtx": 4060,
    "NumGqa": null,
    "NumGpu": -1,
    "MainGpu": null,
    "NumThread": 6,
    "NumKeep": null,
    "RepeatLastN": null,
    "RepeatPenalty": null,
    "PresencePenalty": null,
    "FrequencyPenalty": null,
    "Temperature": 0.7,
    "Seed": null,
    "Stop": null,
    "Tfs_z": null,
    "NumPredict": 600,
    "TopK": null,
    "TopP": null,
    "MinP": null,
    "TypicalP": null,
    "PenalizeNewline": null,
    "UseMmap": null,
    "UseMlock": null,
    "LowVram": null,
    "F16kv": null,
    "LogitsAll": null,
    "VocabOnly": null,
    "Numa": null
  }
}
