{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "@mt = 'An unhandled exception has occurred while executing the request.'"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ApiSettings": {
    "DefaultModel": "llama3.1:8b",
    "DefaultEmbedder": "nomic-embed-text",
    "EmbeddingModels": [ "nomic-embed-text", "qwen3-embedding:0.6b", "mxbai-embed-large:latest", "all-minilm" ],
    "ServerUrls": {
      "ollama": "http://localhost:11434",
      "chroma": "http://localhost:9090"
    }
  },
  "OllamaSettings": {
    "MiroStat": 1,
    "MiroStatEta": null,
    "MiroStatTau": null,
    "NumCtx": 4060,
    "NumGqa": null,
    "NumGpu": -1,
    "MainGpu": null,
    "NumThread": 6,
    "NumKeep": null,
    "RepeatLastN": null,
    "RepeatPenalty": null,
    "PresencePenalty": null,
    "FrequencyPenalty": null,
    "Temperature": 0.7,
    "Seed": null,
    "Stop": null,
    "Tfs_z": null,
    "NumPredict": 600,
    "TopK": null,
    "TopP": null,
    "MinP": null,
    "TypicalP": null,
    "PenalizeNewline": null,
    "UseMmap": null,
    "UseMlock": null,
    "LowVram": null,
    "F16kv": null,
    "LogitsAll": null,
    "VocabOnly": null,
    "Numa": null
  }
}
